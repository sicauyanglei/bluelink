<Window x:Class="BluetoothFileServer.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BluLink 设置" Height="520" Width="520"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="设置"
                   FontSize="20" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   Margin="0,0,0,16"/>

        <!-- Connection Settings -->
        <GroupBox Grid.Row="1" Header="连接">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="最大并发连接数:"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,8"/>
                <TextBox x:Name="MaxConnectionsTextBox"
                         Grid.Row="0" Grid.Column="1"
                         Width="80" Height="32"
                         Text="5"
                         VerticalContentAlignment="Center"
                         TextAlignment="Center"
                         FontSize="13"
                         Padding="8,4"/>
                <TextBlock Grid.Row="0" Grid.Column="2"
                           Text="(1-50)"
                           Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center"
                           Margin="8,0,0,8"
                           FontSize="11"/>

                <CheckBox x:Name="AutoStartServersCheckBox"
                          Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                          Content="启动应用时自动启动蓝牙和TCP服务"
                          VerticalAlignment="Center"
                          Margin="0,8,0,0"/>
            </Grid>
        </GroupBox>

        <!-- Storage Settings -->
        <GroupBox Grid.Row="2" Header="存储" Margin="0,0,0,0">
            <Grid Margin="0,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="共享目录与上传目录可在主窗口修改，此处提供快捷入口。"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <Button x:Name="OpenShareFolderButton"
                            Content="打开共享目录"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Width="120" Height="32"
                            Click="OpenShareFolder_Click"/>
                    <Button x:Name="OpenUploadFolderButton"
                            Content="打开上传目录"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Width="120" Height="32"
                            Margin="10,0,0,0"
                            Click="OpenUploadFolder_Click"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Diagnostics -->
        <GroupBox Grid.Row="3" Header="诊断">
            <Grid Margin="0,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="查看日志文件和配置文件位置。"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="11"
                           Margin="0,0,0,8"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <Button x:Name="OpenLogButton"
                            Content="打开日志文件"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Width="120" Height="32"
                            Click="OpenLog_Click"/>
                    <Button x:Name="OpenConfigButton"
                            Content="打开配置目录"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Width="120" Height="32"
                            Margin="10,0,0,0"
                            Click="OpenConfig_Click"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- About -->
        <GroupBox Grid.Row="4" Header="关于">
            <StackPanel Margin="0,4">
                <TextBlock x:Name="VersionText"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12"
                           Margin="0,0,0,4"/>
                <TextBlock Text="BluLink 文件传输服务端 - 同一WiFi网络下快速传输文件"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </GroupBox>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="CancelButton"
                    Content="取消"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Width="90" Height="36"
                    Click="Cancel_Click"/>
            <Button x:Name="SaveButton"
                    Content="保存"
                    Style="{StaticResource ModernButtonStyle}"
                    Width="90" Height="36"
                    Margin="10,0,0,0"
                    Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
